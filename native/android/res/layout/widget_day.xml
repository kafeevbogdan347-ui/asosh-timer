<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет «Уроки на день» (DayWidget): заголовок и до 8 строк «1. 08:30  Математика · каб. 12» -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/day_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:id="@+id/day_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="АСОШ Таймер"
        android:textColor="#2DD4BF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/day_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Открой АСОШ Таймер, чтобы виджет узнал расписание"
        android:textColor="#9FB3D1"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/day_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text=""
        android:textColor="#F5F7FA"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/day_row2"
