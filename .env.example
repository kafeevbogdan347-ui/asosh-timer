# Скопируйте этот файл в .env и заполните значения. Файл .env не коммитится.

# GEMINI_API_KEY: ключ Gemini API для ИИ-помощника (необязателен:
# без ключа сервер отвечает резервными подсказками)
GEMINI_API_KEY=""

# YANDEX_API_KEY / YANDEX_FOLDER_ID: ключ YandexGPT (Yandex Cloud Foundation Models), необязателен
YANDEX_API_KEY=""
YANDEX_FOLDER_ID=""

# SUPABASE (необязательно, можно настроить и в интерфейсе приложения)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOi..."

# FIREBASE (чат класса). Значения из консоли Firebase → Project settings → Your apps
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_DATABASE_URL=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# DEV_PASSWORD: пароль панели разработчика. Проверяется только на сервере
DEV_PASSWORD=""

# CLASS_CODES: приватные коды классов в формате "Класс:код" через запятую
# Пример: CLASS_CODES="5А:5А-XXXX,5Б:5Б-YYYY"
CLASS_CODES=""
