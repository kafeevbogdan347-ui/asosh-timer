# Скопируйте этот файл в .env и заполните значения. Файл .env не коммитится.
# На GitHub всё содержимое .env кладётся в секрет репозитория APP_ENV.

# CLASS_CODES: коды классов в формате "Класс:код" через запятую. Обновляются каждый год.
# В приложение попадают только SHA-256-отпечатки кодов, открытым текстом их там нет.
# Пример: CLASS_CODES="5А:5А-XXXX,5Б:5Б-YYYY"
CLASS_CODES=""

# DEV_PASSWORD: пароль панели разработчика (в приложении хранится только отпечаток)
DEV_PASSWORD=""

# FIREBASE (чат класса). Значения из консоли Firebase → Project settings → Your apps
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_DATABASE_URL=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
